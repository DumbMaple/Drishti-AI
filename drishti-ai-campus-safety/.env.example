# Backend Integration URLs
# Point this to your backend server (e.g. http://localhost:8000 or http://localhost:5000)
VITE_API_BASE_URL=""

# WebSocket URL for real-time model streaming detections (optional, defaults to ws://<host>/ws/detections)
VITE_WS_URL=""

# GEMINI_API_KEY: Optional for AI Studio runtime or external Gemini calls
GEMINI_API_KEY=""

# APP_URL: Host URL
APP_URL="http://localhost:3000"

